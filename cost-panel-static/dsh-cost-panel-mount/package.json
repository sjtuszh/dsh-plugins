{
  "name": "dsh-cost-panel-mount",
  "version": "1.0.0",
  "description": "双轨计费面板 Typert remote 挂载条目(双条目方案 A:仅 ctx.remote.$mount,不渲染 UI)。与 dsh-cost-panel 配套,为总量统计提供实时轮询接口。",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjtuszh/dsh-plugins.git"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "cost",
    "billing",
    "plugin",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
