{
  "name": "dsh-session-organizer-mount",
  "version": "1.0.0",
  "private": true,
  "description": "会话侧边栏组织器 Typert remote 挂载条目(双条目方案 A:仅 $mount,不渲染 UI)",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
