{
  "name": "dsh-xchat",
  "version": "1.0.0",
  "private": true,
  "description": "跨会话知识桥：@ 任意位置触发会话候选（自绘菜单，跟随主题），在目标会话名下原生拉起继承其记忆的 fork 子代理，跨会话询问/追问/结束。",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
